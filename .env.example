# Copy to .env. EXPO_PUBLIC_* values are bundled into the app, so use no secrets.
# Leave blank to use the existing Metro-host/platform fallback.
EXPO_PUBLIC_API_URL=

# To override, include /api and choose an address reachable by your device:
# Physical device: http://YOUR_COMPUTER_LAN_IP:5000/api
# Android emulator: http://10.0.2.2:5000/api
# iOS simulator: http://localhost:5000/api
# Restart Expo after changing this file.
